{
  "name": "household-inventory-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode release",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --mode Release",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:watch": "node --watch --import tsx --test tests/unit/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.16.0",
    "@supabase/supabase-js": "^2.110.9",
    "react": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-config": "^1.7.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
