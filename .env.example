# -----------------------------------------------------------------------------
# Supabase (new hosted backend)
# -----------------------------------------------------------------------------
# Safe to expose in the mobile bundle. Get both values from the Supabase
# project's Connect dialog / Settings > API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# -----------------------------------------------------------------------------
# Firebase (temporary while the migration is in progress)
# -----------------------------------------------------------------------------
# Keep these until the final Firebase-removal PR. Existing app flows still use
# Firebase while their Supabase replacements are being implemented and tested.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# Optional when testing emulators from a physical device on the same LAN:
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# GROQ_API_KEY must NOT be placed in this file with an EXPO_PUBLIC_ prefix.
# Store it in Supabase Edge Function secrets instead.
