# Public mobile client configuration.
# These values are compiled into the native application and must never contain
# Supabase service-role keys or other server-side secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets such as GROQ_API_KEY belong in Supabase Edge Function
# secrets, not in this mobile .env file.
