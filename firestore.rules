rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid);
    }

    function isMember(householdId) {
      return signedIn() && exists(memberPath(householdId));
    }

    function validItemStatus(data) {
      return data.quantity <= 0
        ? data.status == 'out_of_stock'
        : (data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.quantity <= data.lowStockThreshold)
          ? data.status == 'low_stock'
          : data.status == 'available';
    }

    function validItem(data) {
      return data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.normalizedName is string
        && data.normalizedName.size() >= 1
        && data.categoryId is string
        && data.categoryName is string
        && data.quantity is number
        && data.quantity >= 0
        && data.quantity <= 100000
        && data.currentPriceCents is int
        && data.currentPriceCents >= 0
        && data.currentPriceCents <= 100000000
        && data.currency is string
        && data.currency.size() == 3
        && data.addedBy is string
        && data.updatedBy is string
        && (data.lowStockThreshold == null || (data.lowStockThreshold is number && data.lowStockThreshold >= 0))
        && validItemStatus(data);
    }

    function validShoppingItem(data, householdId) {
      return data.itemId is string
        && data.itemId.size() >= 1
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.quantityNeeded is number
        && data.quantityNeeded > 0
        && data.quantityNeeded <= 100000
        && data.estimatedPriceCents is int
        && data.estimatedPriceCents >= 0
        && data.estimatedPriceCents <= 100000000
        && data.priority in ['normal', 'important', 'urgent']
        && data.status == 'active'
        && data.addedBy is string
        && exists(/databases/$(database)/documents/households/$(householdId)/items/$(data.itemId));
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /households/{householdId} {
      allow create, update, delete: if false; // Trusted backend operations only.
      allow read: if isMember(householdId);

      match /members/{userId} {
        allow read: if isMember(householdId);
        allow create, update, delete: if false; // Membership/role changes use trusted backend code.
      }

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && validItem(request.resource.data)
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if isMember(householdId)
          && validItem(request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isMember(householdId);
      }

      match /shoppingList/{shoppingItemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && validShoppingItem(request.resource.data, householdId)
          && request.resource.data.itemId == shoppingItemId
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if isMember(householdId)
          && validShoppingItem(request.resource.data, householdId)
          && request.resource.data.itemId == shoppingItemId
          && request.resource.data.itemId == resource.data.itemId
          && (
            request.resource.data.addedBy == resource.data.addedBy
            || (resource.data.status != 'active' && request.resource.data.addedBy == request.auth.uid)
          );
        allow delete: if isMember(householdId);
      }

      match /purchases/{purchaseId} {
        allow read: if isMember(householdId);
        allow write: if false; // Purchase writes are transactional backend operations.
      }

      match /priceHistory/{priceHistoryId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(householdId);
        allow write: if false; // Expense math and debt creation are trusted backend operations.
      }

      match /budgets/{period} {
        allow read: if isMember(householdId);
        allow write: if false; // Budget changes use the admin callable.
      }

      match /aiInsights/{period} {
        allow read: if isMember(householdId);
        allow write: if false; // Generated by the trusted Groq-backed callable only.
      }

      match /activities/{activityId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read: if isMember(householdId);
        allow write: if false; // Category management will use admin backend operations.
      }
    }

    match /aiUsage/{usageId} {
      allow read, write: if false; // AI cost/abuse quota state is backend-only.
    }

    match /pushReceipts/{receiptId} {
      allow read, write: if false; // Expo delivery receipts are backend-only infrastructure.
    }

    match /inviteCodes/{inviteCode} {
      allow read, write: if false; // Access only through trusted backend functions.
    }
  }
}
